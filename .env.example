# Copy this file to `.env` and fill in the values.
# `.env` is listed in .gitignore so your token is never uploaded to GitHub.
# NEVER share your bot token — anyone with it can control your bot.

# Required: your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: a server ID to register slash commands to instantly while testing.
# Leave blank to register globally (works in every server the bot is in).
GUILD_ID=

# Optional: how often to check TikTok, in seconds (minimum 30). Default 90.
POLL_INTERVAL_SECONDS=90

# Optional: a TikTok "sessionid" cookie value. Only needed if TikTok starts
# blocking anonymous requests from your server's IP.
TIKTOK_SESSIONID=
